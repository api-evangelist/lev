            "name": "List placements with pagination",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lev.com/api/external/v2/placements",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Results per page (1–200, default 50)"
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Cursor for next page"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List placements with pagination\n\nDocs page: https://www.lev.com/docs/build/placements"
